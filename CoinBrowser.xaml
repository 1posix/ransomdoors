<Window x:Class="rans0m.CoinBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorateur de pièces — RANS0M Lab" Width="740" Height="580"
        WindowStartupLocation="CenterScreen" Background="#171922" Foreground="White">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="PARCOURS LES DOSSIERS DE LA SIMULATION" FontSize="20" FontWeight="Bold" Foreground="#FFD15A" />
            <TextBlock x:Name="txt_help" Text="Développe les dossiers puis DOUBLE-CLIQUE sur une pièce d'or pour la récupérer."
                       TextWrapping="Wrap" Margin="0,6,0,8"/>
            <TextBlock x:Name="txt_remaining" FontSize="16" Foreground="#FFD15A" />
        </StackPanel>
        <TreeView x:Name="folders" Background="#212633" Foreground="White" BorderThickness="0"
                  MouseDoubleClick="Folders_DoubleClick"/>
    </DockPanel>
</Window>
