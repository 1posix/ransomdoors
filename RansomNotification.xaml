<Window x:Class="rans0m.RansomNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RANS0M Lab — Simulation" Width="590" Height="465"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1F080A"
        Foreground="White" Topmost="True" ShowInTaskbar="True" AllowDrop="True"
        Loaded="Window_Loaded" DragEnter="Window_DragEnter" Drop="Window_Drop"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Assets/ransom_idle.png" Width="112" Height="112"/>
            <TextBlock Margin="18,0,0,0" Width="370" FontFamily="Consolas" FontWeight="Bold"
                       TextWrapping="Wrap" FontSize="31" Foreground="#FF6969"
                       Text="YOUR FILES HAVE BEEN ENCRYPTED" />
        </StackPanel>
        <TextBlock x:Name="txt_howto" Grid.Row="1" Margin="0,0,0,20" Padding="12" FontSize="17"
                   Background="#4B0C11" TextWrapping="Wrap"
                   Text="Find the gold coins in the simulated folders and pay before the countdown expires!"/>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Gold.png" Width="44" Height="44"/>
                <TextBlock x:Name="txt_ransomLeft" Text="500" Foreground="#FFCD40" FontSize="37"
                           FontWeight="Bold" FontFamily="Consolas" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="txt_timer" Grid.Column="1" Text="TIME: 01:30" FontSize="29"
                       FontFamily="Consolas" Foreground="#FF6969" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btn_browse" Width="200" Height="40" Margin="0,0,14,0" Content="Chercher les pièces" Click="Browse_Click"/>
            <Button Width="200" Height="40" Content="Quitter (sans risque)" Click="Quit_Click"/>
        </StackPanel>
        <TextBlock x:Name="txt_footer" Grid.Row="4" FontSize="12" Foreground="#FFD8C8" TextWrapping="Wrap"
                   Text="EXERCICE DE SENSIBILISATION — Aucun fichier personnel n'est chiffré. Double-clique les pièces dans l'explorateur fictif, ou glisse les pièces depuis le dossier de simulation sur cette fenêtre. Ctrl+Maj+F12 pour arrêter."/>
    </Grid>
</Window>
