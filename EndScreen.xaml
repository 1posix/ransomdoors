<Window x:Class="rans0m.EndScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RANS0M Lab — Résultat" Width="680" Height="495"
        WindowStartupLocation="CenterScreen" Background="#190E12" Foreground="White"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        Closing="Window_Closing" Closed="Window_Closed">
    <Border BorderBrush="#694248" BorderThickness="2" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#342026" Padding="10" Margin="0,0,0,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="RANS0M LAB — RÉSULTAT DE LA SIMULATION"
                           FontFamily="Consolas" FontSize="13" Foreground="#D9B7BC"
                           TextAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" x:Name="txt_title" FontFamily="Consolas" FontSize="31"
                       FontWeight="Bold" Foreground="#FF6464" TextAlignment="Center"
                       Margin="0,10,0,22" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="4" Margin="0,0,0,14">
                <TextBlock x:Name="txt_message" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="19" />
            </ScrollViewer>
            <Border Grid.Row="3" BorderBrush="#707070" BorderThickness="1"
                    Padding="15" Margin="0,0,0,22">
                <TextBlock FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Foreground="#82E6B5"
                           Text="SIMULATION TERMINÉE — Aucun fichier personnel n'a été chiffré ou supprimé. Verrouille ta session avec Win + L lorsque tu t'absentes." />
            </Border>
            <Button Grid.Row="4" Content="Terminer et quitter" Height="48"
                    Click="Close_Click" IsDefault="False" IsCancel="False" />
        </Grid>
    </Border>
</Window>
